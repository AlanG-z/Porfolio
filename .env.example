# Configuración del bot local compatible con OpenAI / llama.cpp
# Copia este archivo a .env.local y reinicia Vite después de cambiarlo.

# Dirección del servidor local del modelo (no incluyas /v1 aquí).
VITE_LLM_PROXY_TARGET=http://0.0.0.0:8080


# Opcional: solo si el servidor exige Bearer token. Se inyecta en el proxy,
# no se envía al bundle del navegador.
VITE_LLM_PROXY_KEY=

# Identificador del modelo servido por llama.cpp.
# Cámbialo si tu servidor usa otro nombre.
VITE_LLM_MODEL=FG-Inteligencia
